{
  "name": "test-inventory",
  "version": "0.0.0",
  "description": "Test metadata from source code, not from test results.",
  "keywords": [
    "testing",
    "test-suite",
    "test-inventory",
    "static-analysis",
    "ast",
    "json",
    "cli"
  ],
  "homepage": "https://huldoser.github.io/test-inventory/",
  "bugs": {
    "url": "https://github.com/Huldoser/test-inventory/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Huldoser/test-inventory.git"
  },
  "license": "MIT",
  "author": "Andrey Rychkov",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "oxc-parser": "0.153.0",
    "tinyglobby": "^0.2.17"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "@vitest/coverage-v8": "5.0.3",
    "typescript": "~6.0.3",
    "vitest": "5.0.3"
  }
}
