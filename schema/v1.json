        "repeats": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ],
          "description": "How many times the runner runs the test again after the first run: Vitest's `repeats`, or Playwright's `repeatEach` from the config less one."
        },
        "timeoutSource": {
          "anyOf": [
            {
              "$ref": "#/definitions/SettingSource"
            },
            {
              "type": "null"
            }
