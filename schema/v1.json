{
  "$id": "https://huldoser.github.io/test-inventory/schema/v1.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/Inventory",
  "definitions": {
    "Inventory": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1,
          "description": "Version of this format. It changes only when a key is removed, renamed or changes meaning."
        },
        "tool": {
          "$ref": "#/definitions/Tool"
        },
        "framework": {
          "$ref": "#/definitions/Framework",
          "description": "The framework the scan was run for."
        },
        "frameworkVersion": {
          "type": [
            "string",
            "null"
          ],
          "description": "Read from the project, or given with `--framework-version`; null when unknown."
        },
        "summary": {
          "$ref": "#/definitions/Summary"
        },
        "configs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ConfigRecord"
          },
          "description": "The configs the scanned files use, sorted by path."
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FileRecord"
          },
          "description": "One per scanned file, in the order the files were scanned."
        },
        "suites": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SuiteRecord"
          }
        },
        "tests": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/TestRecord"
          }
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Diagnostic"
          }
        }
      },
      "required": [
        "schemaVersion",
        "tool",
        "framework",
        "frameworkVersion",
        "summary",
        "configs",
        "files",
        "suites",
        "tests",
        "diagnostics"
      ],
      "description": "The output of one scan."
    },
    "Tool": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "const": "test-inventory"
        },
        "version": {
          "type": "string",
          "description": "Version of test-inventory that produced the output."
        }
      },
      "required": [
        "name",
        "version"
      ]
    },
    "Framework": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "playwright",
            "vitest"
          ]
        },
        {
          "type": "string"
        }
      ]
    },
    "Summary": {
      "type": "object",
      "properties": {
        "fileCount": {
          "type": "integer",
          "minimum": 0,
          "description": "Test files scanned."
        },
        "suiteCount": {
          "type": "integer",
          "minimum": 0
        },
        "testCount": {
          "type": "integer",
          "minimum": 0
        },
        "activeCount": {
          "type": "integer",
          "minimum": 0
        },
        "skipCount": {
          "type": "integer",
          "minimum": 0
        },
        "fixmeCount": {
          "type": "integer",
          "minimum": 0
        },
        "todoCount": {
          "type": "integer",
          "minimum": 0
        },
        "expectedToFailCount": {
          "type": "integer",
          "minimum": 0
        },
        "notLoadedCount": {
          "type": "integer",
          "minimum": 0
        },
        "onlyCount": {
          "type": "integer",
          "minimum": 0
        },
        "conditionalCount": {
          "type": "integer",
          "minimum": 0
        },
        "parallelCount": {
          "type": "integer",
          "minimum": 0
        },
        "serialCount": {
          "type": "integer",
          "minimum": 0
        },
        "parameterizedCount": {
          "type": "integer",
          "minimum": 0
        },
        "inLoopCount": {
          "type": "integer",
          "minimum": 0
        },
        "inConditionCount": {
          "type": "integer",
          "minimum": 0
        },
        "inFunctionCount": {
          "type": "integer",
          "minimum": 0
        },
        "typeTestCount": {
          "type": "integer",
          "minimum": 0
        },
        "benchmarkCount": {
          "type": "integer",
          "minimum": 0
        },
        "diagnosticCount": {
          "type": "integer",
          "minimum": 0
        },
        "tagCounts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          },
          "description": "Tests per tag."
        },
        "annotationCounts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          },
          "description": "Tests per annotation type."
        }
      },
      "required": [
        "fileCount",
        "suiteCount",
        "testCount",
        "activeCount",
        "skipCount",
        "fixmeCount",
        "todoCount",
        "expectedToFailCount",
        "notLoadedCount",
        "onlyCount",
        "conditionalCount",
        "parallelCount",
        "serialCount",
        "parameterizedCount",
        "inLoopCount",
        "inConditionCount",
        "inFunctionCount",
        "typeTestCount",
        "benchmarkCount",
        "diagnosticCount",
        "tagCounts",
        "annotationCounts"
      ],
      "description": "Counts over the whole scan. Each test count uses the same definition as the matching test key."
    },
    "ConfigRecord": {
      "type": "object",
      "properties": {
        "relativeFilePath": {
          "type": "string",
          "description": "Path from the project root, with `/` separators."
        },
        "extends": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Files the config takes settings from through imports, such as a shared base config, in the order read."
        },
        "projects": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/definitions/ProjectRecord"
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "The projects the config runs tests in: Playwright's `projects`, or one for a config without them; Vitest's, with each browser instance as one. Null when the scan can't work them out."
        }
      },
      "required": [
        "relativeFilePath",
        "extends",
        "projects"
      ],
      "description": "A Playwright or Vitest config that scanned files use: the nearest one in a file's folder or a folder above it, up to the root, as the runner started in that folder would. Read as code, never run."
    },
    "ProjectRecord": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "As the runner names it: `''` for a project without a name."
        },
        "testDir": {
          "type": "string",
          "description": "The folder the project's test files are found in, from the project root: Playwright's `testDir`, Vitest's `dir`."
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Playwright's projects that run before this one; `[]` for Vitest."
        }
      },
      "required": [
        "name",
        "testDir",
        "dependencies"
      ]
    },
    "FileRecord": {
      "type": "object",
      "properties": {
        "relativeFilePath": {
          "type": "string",
          "description": "Path from the project root, with `/` separators."
        },
        "fileName": {
          "type": "string"
        },
        "config": {
          "type": [
            "string",
            "null"
          ],
          "description": "The config the file uses, from the project root: the outermost config at or above it that runs it, as the runner started at the root would, else the nearest. Null when there is none."
        },
        "hooks": {
          "$ref": "#/definitions/HookCounts",
          "description": "Hooks at the top level of the file, which run around every test in it."
        },
        "suiteCount": {
          "type": "integer",
          "minimum": 0
        },
        "testCount": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "relativeFilePath",
        "fileName",
        "config",
        "hooks",
        "suiteCount",
        "testCount"
      ],
      "description": "A scanned file, also one that has no tests or could not be read."
    },
    "HookCounts": {
      "type": "object",
      "properties": {
        "beforeAll": {
          "type": "integer",
          "minimum": 0
        },
        "beforeEach": {
          "type": "integer",
          "minimum": 0
        },
        "afterEach": {
          "type": "integer",
          "minimum": 0
        },
        "afterAll": {
          "type": "integer",
          "minimum": 0
        },
        "aroundEach": {
          "type": "integer",
          "minimum": 0,
          "description": "Vitest only."
        },
        "aroundAll": {
          "type": "integer",
          "minimum": 0,
          "description": "Vitest only."
        }
      },
      "required": [
        "beforeAll",
        "beforeEach",
        "afterEach",
        "afterAll",
        "aroundEach",
        "aroundAll"
      ],
      "description": "How many hooks of each kind are registered, including by helper functions called there."
    },
    "SuiteRecord": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        },
        "parentId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{16}$"
            },
            {
              "type": "null"
            }
          ],
          "description": "The describe around this one; null at the top level."
        },
        "bodyHash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{16}$"
            },
            {
              "type": "null"
            }
          ],
          "description": "Hash of the describe's own code (hooks, `test.use()`, `describe.configure()`, helpers), ignoring whitespace, comments, and nested tests and describes; null when nothing is left."
        },
        "relativeFilePath": {
          "type": "string",
          "description": "Path from the project root, with `/` separators."
        },
        "fileName": {
          "type": "string"
        },
        "lineStart": {
          "type": "integer",
          "minimum": 1
        },
        "lineEnd": {
          "type": "integer",
          "minimum": 1
        },
        "columnStart": {
          "type": "integer",
          "minimum": 1,
          "description": "In UTF-16 code units."
        },
        "columnEnd": {
          "type": "integer",
          "minimum": 1,
          "description": "In UTF-16 code units."
        },
        "declaredAt": {
          "anyOf": [
            {
              "$ref": "#/definitions/DeclaredAt"
            },
            {
              "type": "null"
            }
          ],
          "description": "Where a helper imported from another file writes the describe; the record's location is then the call that registers it. Null for code written in the scanned file."
        },
        "title": {
          "type": "string",
          "description": "As the runner shows it, tags included."
        },
        "titleWithoutTags": {
          "type": "string",
          "description": "`title` with `@tag` words removed and spaces tidied."
        },
        "hasDynamicTitle": {
          "type": "boolean",
          "description": "The title could not be resolved to a fixed string, so `title` holds its source text."
        },
        "path": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Titles of the describes around this one and of this one, outermost first."
        },
        "isSkipped": {
          "type": "boolean"
        },
        "isFixme": {
          "type": "boolean",
          "description": "Playwright only."
        },
        "isTodo": {
          "type": "boolean",
          "description": "Vitest only."
        },
        "isExpectedToFail": {
          "type": "boolean",
          "description": "Tests in the describe are expected to fail, as with `test.fail()` in its body. Playwright only."
        },
        "isOnly": {
          "type": "boolean"
        },
        "isConditional": {
          "type": "boolean",
          "description": "The state applies only when a condition holds."
        },
        "condition": {
          "type": [
            "string",
            "null"
          ],
          "description": "Source text of the condition, shortened when long; null when unconditional."
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "hasDynamicReason": {
          "type": "boolean",
          "description": "The reason could not be worked out to a string, so `reason` holds its source text."
        },
        "isParallel": {
          "type": "boolean"
        },
        "isSerial": {
          "type": "boolean",
          "description": "Playwright only."
        },
        "isShuffled": {
          "type": "boolean",
          "description": "Vitest only."
        },
        "isParameterized": {
          "type": "boolean",
          "description": "Declared with `.each` or `.for`."
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "annotations": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Annotation"
          }
        },
        "locks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Playwright only."
        },
        "meta": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/definitions/MetaValue"
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "Vitest only; literal values only."
        },
        "hooks": {
          "$ref": "#/definitions/HookCounts",
          "description": "Hooks registered directly in the describe."
        },
        "timeout": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ],
          "description": "In milliseconds; null when nothing here sets it."
        },
        "isSlow": {
          "type": "boolean",
          "description": "Playwright `test.slow()` written in the describe, which triples the timeout of its tests."
        },
        "slowCondition": {
          "type": [
            "string",
            "null"
          ],
          "description": "Source text of the `test.slow()` condition; null when unconditional or not slow."
        },
        "retries": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "retryDelay": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ],
          "description": "Vitest only: milliseconds between retries, from the `retry` object (4.1)."
        },
        "retryCondition": {
          "type": [
            "string",
            "null"
          ],
          "description": "Vitest only: source text of the `retry` object's `condition`, a RegExp or a function."
        },
        "repeats": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ],
          "description": "Vitest only: how many times the runner runs each test again after the first run."
        }
      },
      "required": [
        "id",
        "parentId",
        "bodyHash",
        "relativeFilePath",
        "fileName",
        "lineStart",
        "lineEnd",
        "columnStart",
        "columnEnd",
        "declaredAt",
        "title",
        "titleWithoutTags",
        "hasDynamicTitle",
        "path",
        "isSkipped",
        "isFixme",
        "isTodo",
        "isExpectedToFail",
        "isOnly",
        "isConditional",
        "condition",
        "reason",
        "hasDynamicReason",
        "isParallel",
        "isSerial",
        "isShuffled",
        "isParameterized",
        "tags",
        "annotations",
        "locks",
        "meta",
        "hooks",
        "timeout",
        "isSlow",
        "slowCondition",
        "retries",
        "retryDelay",
        "retryCondition",
        "repeats"
      ],
      "description": "A describe block, with what is written on the describe itself. Inherited values are on the tests."
    },
    "DeclaredAt": {
      "type": "object",
      "properties": {
        "relativeFilePath": {
          "type": "string",
          "description": "The helper's file, from the project root."
        },
        "lineStart": {
          "type": "integer",
          "minimum": 1
        },
        "columnStart": {
          "type": "integer",
          "minimum": 1,
          "description": "In UTF-16 code units."
        }
      },
      "required": [
        "relativeFilePath",
        "lineStart",
        "columnStart"
      ]
    },
    "Annotation": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "lineStart": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "type",
        "description",
        "lineStart"
      ]
    },
    "MetaValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/MetaValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/MetaValue"
          }
        }
      ]
    },
    "TestRecord": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$",
          "description": "Derived from the file path, the describe titles, the title and its position among tests with the same title."
        },
        "bodyHash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{16}$"
            },
            {
              "type": "null"
            }
          ],
          "description": "Hash of the test body, ignoring whitespace and comments; null when the test has no body."
        },
        "suiteId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{16}$"
            },
            {
              "type": "null"
            }
          ],
          "description": "The nearest describe; null outside any describe."
        },
        "suitePath": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Titles of the describes around the test, outermost first."
        },
        "relativeFilePath": {
          "type": "string",
          "description": "Path from the project root, with `/` separators."
        },
        "fileName": {
          "type": "string"
        },
        "lineStart": {
          "type": "integer",
          "minimum": 1
        },
        "lineEnd": {
          "type": "integer",
          "minimum": 1
        },
        "columnStart": {
          "type": "integer",
          "minimum": 1,
          "description": "In UTF-16 code units."
        },
        "columnEnd": {
          "type": "integer",
          "minimum": 1,
          "description": "In UTF-16 code units."
        },
        "declaredAt": {
          "anyOf": [
            {
              "$ref": "#/definitions/DeclaredAt"
            },
            {
              "type": "null"
            }
          ],
          "description": "Where a helper imported from another file writes the test; the record's location is then the call that registers it. Null for code written in the scanned file."
        },
        "title": {
          "type": "string",
          "description": "As the runner shows it, tags included."
        },
        "titleWithoutTags": {
          "type": "string",
          "description": "`title` with `@tag` words removed and spaces tidied."
        },
        "hasDynamicTitle": {
          "type": "boolean",
          "description": "The title could not be resolved to a fixed string, so `title` holds its source text."
        },
        "fullName": {
          "type": "string",
          "description": "`suitePath` and `title` joined with \" > \"."
        },
        "isTypeTest": {
          "type": "boolean",
          "description": "Declared in a Vitest type test file (`*.test-d.ts`, `*.spec-d.ts`)."
        },
        "state": {
          "$ref": "#/definitions/TestState"
        },
        "isActive": {
          "type": "boolean"
        },
        "isSkipped": {
          "type": "boolean"
        },
        "isFixme": {
          "type": "boolean"
        },
        "isTodo": {
          "type": "boolean"
        },
        "isExpectedToFail": {
          "type": "boolean"
        },
        "isNotLoaded": {
          "type": "boolean",
          "description": "The runner refuses to load the file; a diagnostic at `stateLine` says why."
        },
        "isOnly": {
          "type": "boolean",
          "description": "The test or a describe around it uses `.only`."
        },
        "isConditional": {
          "type": "boolean",
          "description": "The state applies only when a condition holds, as with `test.skip(condition)` or `skipIf`."
        },
        "condition": {
          "type": [
            "string",
            "null"
          ],
          "description": "Source text of the condition, shortened when long; null when unconditional."
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "hasDynamicReason": {
          "type": "boolean",
          "description": "The reason could not be worked out to a string, so `reason` holds its source text."
        },
        "stateSource": {
          "anyOf": [
            {
              "$ref": "#/definitions/StateSource"
            },
            {
              "type": "null"
            }
          ],
          "description": "null for active tests."
        },
        "stateLine": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ],
          "description": "The line that sets the state; null for active tests."
        },
        "isParallel": {
          "type": "boolean",
          "description": "Both `isParallel` and `isSerial` false means the framework's default mode."
        },
        "isSerial": {
          "type": "boolean"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "From the test and every describe around it, outermost first, without duplicates."
        },
        "annotations": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Annotation"
          }
        },
        "comments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Comment lines directly above the test. By default only filled for tests that are not active."
        },
        "locks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "From the test, its describes and the `test.describe.configure()` calls around it. Playwright only."
        },
        "meta": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/definitions/MetaValue"
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "Merged from the describes and the test. Vitest only; literal values only."
        },
        "hooks": {
          "$ref": "#/definitions/HookCounts",
          "description": "Every hook that runs around the test: those of the file and of each describe around it."
        },
        "timeout": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ],
          "description": "In milliseconds: the last `test.setTimeout()` in the body or a `beforeEach`, otherwise the nearest describe or file that sets one, otherwise the config. Null when none sets it, so the runner's default applies."
        },
        "isSlow": {
          "type": "boolean",
          "description": "Playwright `test.slow()` applies: the runner triples the timeout."
        },
        "slowCondition": {
          "type": [
            "string",
            "null"
          ],
          "description": "Source text of the condition of the `test.slow()` that applies; null when unconditional or not slow."
        },
        "retries": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ],
          "description": "How many times the runner retries the test when it fails; null when the file sets none."
