        "expectedAssertions": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ],
          "description": "Vitest `expect.assertions(n)` in the body."
        },
        "expectsAssertions": {
          "type": "boolean",
          "description": "Vitest `expect.hasAssertions()` in the body."
        },
        "hasEmptyBody": {
          "type": "boolean",
